	</parameter>
	<queryString>
		<![CDATA[SELECT rownum||'.'|| NVL(PRINTABLE_CHARGE_DESC, CM.CHARGE_NAME)  CHARGE,
nvl(BUY_CURRENCY_CODE,'  ') CURRENCY_CODE, BUY_CURRENCY_RATE BUY_CURRENCY_RATE,
SELL_UNIT_RATE_FC SELLING_CHARGE, QUANTITY, SELL_TOTAL_FC SELLING_CHARGE_LOCAL,
SUM.STOCK_UNIT_CODE EQUIPMENT_TYPE,
c.remarks
FROM SALES_QUOTE_PROJECTS_CHARGE_DTL C
LEFT JOIN SHIP_CHARGE_MASTER CM ON C.CHARGE_POID=CM.CHARGE_POID
LEFT JOIN STOCK_UNIT_MASTER SUM ON C.UNIT_POID=SUM.STOCK_UNIT_POID
WHERE C.TRANSACTION_POID = $P{DOC_KEY_POID}]]>
	</queryString>
	<field name="CHARGE" class="java.lang.String"/>
	<field name="CURRENCY_CODE" class="java.lang.String"/>
	<field name="BUY_CURRENCY_RATE" class="java.math.BigDecimal"/>
	<field name="SELLING_CHARGE" class="java.math.BigDecimal"/>
	<field name="QUANTITY" class="java.math.BigDecimal"/>
