	<field name="EQUIPMENT_TYPE" class="java.lang.String"/>
	<field name="REMARKS" class="java.lang.String"/>
	<variable name="QUANTITY_1" class="java.math.BigDecimal" resetType="Column" calculation="Sum">
		<variableExpression><![CDATA[$F{QUANTITY}]]></variableExpression>
	</variable>
	<variable name="SELLING_CHARGE_1" class="java.math.BigDecimal" resetType="Column" calculation="Sum">
