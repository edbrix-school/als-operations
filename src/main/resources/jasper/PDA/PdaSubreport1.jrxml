    <parameter name="DOC_KEY_POID" class="java.lang.String">
        <defaultValueExpression><![CDATA[]]></defaultValueExpression>
    </parameter>
    <parameter name="P_PRINCIPAL_POID" class="java.lang.String">
        <defaultValueExpression><![CDATA[]]></defaultValueExpression>
    </parameter>
    <parameter name="P_TAX_APPLICABLE" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA['N']]></defaultValueExpression>
    </parameter>
    <queryString>
        <![CDATA[SELECT PED.TRANSACTION_POID,SCM.CHARGE_NAME,PED.CURRENCY_RATE,PED.QTY,PED.DAYS,PED.PDA_RATE,
DECODE(NVL(PED.TAX_PERCENTAGE,0),0,DECODE(GTM.TAX_CATEGORY,'Z',TO_CHAR(NVL(PED.TAX_PERCENTAGE,0)),GTM.TAX_CATEGORY),PED.TAX_PERCENTAGE) AS TAX_PERCENTAGE,
PED.TAX_AMOUNT,(PED.QTY*PED.DAYS*PED.PDA_RATE)*NVL(PED.CURRENCY_RATE,1) AS RATE,
PED.RATE_TYPE_POID,PED.MANUAL,((PED.QTY*PED.DAYS*PED.PDA_RATE)+NVL(PED.TAX_AMOUNT,0))*NVL(PED.CURRENCY_RATE,1) AS AMOUNT,
ROUND((((PED.QTY*PED.DAYS*PED.PDA_RATE)+NVL(PED.TAX_AMOUNT,0))/PEH.CURRENCY_RATE),GCM.CURRENCY_DECIMALS) AS TOTAL_RATE_HDR,
PEH.CURRENCY_CODE,PED.REMARKS AS REMARKS
FROM PDA_ENTRY_DTL PED
INNER JOIN PDA_ENTRY_HDR PEH ON PEH.TRANSACTION_POID=PED.TRANSACTION_POID
LEFT JOIN SHIP_CHARGE_MASTER SCM ON SCM.CHARGE_POID=PED.CHARGE_POID
LEFT JOIN GLOBAL_TAX_MASTER GTM ON GTM.TAX_POID=SCM.TAX_POID
LEFT JOIN GLOBAL_CURRENCY_MASTER GCM ON PEH.CURRENCY_CODE=GCM.CURRENCY_CODE
WHERE PED.TRANSACTION_POID=$P{DOC_KEY_POID} AND PED.PRINCIPAL_POID=$P{P_PRINCIPAL_POID}
ORDER BY PED.SEQNO]]>
    </queryString>
    <field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
    <field name="CHARGE_NAME" class="java.lang.String"/>
    <field name="CURRENCY_RATE" class="java.math.BigDecimal"/>
    <field name="QTY" class="java.math.BigDecimal"/>
    <field name="DAYS" class="java.math.BigDecimal"/>
    <field name="PDA_RATE" class="java.math.BigDecimal"/>
