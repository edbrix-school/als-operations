	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["//ASGERPFS01.SHIPPINGBAHRAIN.COM//ERP_Reports//Reports//"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT TRANSACTION_DATE, DOC_REF, QUOTE_REFERENCE,
	nvl(C.CUSTOMER_NAME,GA.ADDRESS_NAME) AS CUSTOMER,
	NVL(GA1.PO_BOX, GA2.PO_BOX) as PO_BOX, NVL(GA1.BLDG, GA2.BLDG) AS BUILDING,
	GA1.STATE, nvl(C.CUSTOMER_EMAIL, GA1.EMAIL1) AS EMAIL, NVL(GA1.OFF_TEL1,GA2.OFF_TEL1) AS OFFICE_TEL,
	nvl(C.CUSTOMER_CONTACT, GA1.MOBILE) AS MOBILE,
	CASE WHEN C.SHIPMENT_MODE LIKE '%AIR%' THEN AL.AIRLINE_NAME ELSE SL.LINE_NAME END AS LINE_NAME,
    SPM.PRINCIPAL_NAME,
	SM.SALESMAN_NAME || ' (Email:' || SM.EMAIL || ')' AS SALESMAN, DECODE(SM.MOBILE, NULL, NVL(SIGNATURE_TEXT, ' '), 'Mobile:' || SM.MOBILE || ' ' || NVL(SIGNATURE_TEXT, ' ')) AS SALESMAN_MOBILE,
	SM.EMAIL  AS SALESMAN_EMAIL,
    VALIDITY_TO_DATE,
    REPLACE(C.TRANSPORTATION_MODE, '_', ' ') FREIGHT_MODE,
    'Gross :' || NVL(WEIGHT, 0)|| ' ' || 'Freight Tons :' || NVL(FREIGHT_TONS, 0)|| ' ' || UNITS   CHARGEABLE_WEIGHT,
    SC.COMODITY_NAME COMODITY_NAME,
    SHIPPING_TERMS TERMS_OF_FREIGHT,
    SHIPMENT_MODE, TRANSPORTATION_MODE,   NULL DISCHARGE_AIRPORT_POID, NULL LOADING_PORT,
    NULL DISCHARGE_PORT, NULL PLACE_OF_RECEIPT, NULL PLACE_OF_DELIVERY, CBM || ' ' || UNITS VOLUME,
    TERMS_POID TERMS_CONDITION_POID, PROJECT_DETAILS CARGO_DETAILS, SHIPPING_TERMS, C.REMARKS, C.BILLING_CURRENCY_CODE
  FROM SALES_QUOTE_PROJECTS_HDR C
  LEFT JOIN SALES_SALESMAN_MASTER SM ON C.SALESMAN_POID = SM.SALESMAN_POID
  LEFT JOIN SHIP_LINE_MASTER SL ON C.LINE_POID = SL.LINE_POID
  LEFT JOIN FF_AIR_LINE_MASTER AL ON C.LINE_POID = AL.AIRLINE_POID
  LEFT JOIN GLOBAL_ADDRESS_MASTER GA ON C.CUSTOMER_POID = GA.ADDRESS_MASTER_POID
  LEFT JOIN VIEW_SALES_ADDRESS GA1 ON GA.ADDRESS_MASTER_POID = GA1.ADDRESS_MASTER_POID
  LEFT JOIN VIEW_MAIN_ADDRESS GA2 ON GA.ADDRESS_MASTER_POID = GA2.ADDRESS_MASTER_POID
  LEFT JOIN SHIP_COMODITY_MASTER SC ON C.COMMODITY = SC.COMODITY_CODE
  LEFT JOIN SHIP_PRINCIPAL_MASTER SPM ON C.PRINCIPAL_POID=SPM.PRINCIPAL_POID
WHERE TRANSACTION_POID =  $P{DOC_KEY_POID}]]>
	</queryString>
